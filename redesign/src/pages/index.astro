---
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { siteContent } from "../data/site";

const { identity, hero, openingQuestion, researchThemes } = siteContent;
---

<SiteLayout
  title={`${identity.name} | Ant evolution, biodiversity, and symbiosis`}
  description="The Probst Lab at UC Davis studies ant evolution, ant–plant symbioses, phylogenomics, and biodiversity."
>
  <SiteHeader variant="home" />

  <main>
    <section class:list={["hero", { "hero--without-image": !hero.image.show }]}>
      <div class="hero-copy">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.title}</h1>
        <p class="hero-summary">{hero.summary}</p>

        <div class="hero-actions">
          <a class="button button--primary" href={hero.primaryLink.href}>
            {hero.primaryLink.label}
            <span aria-hidden="true">↘</span>
          </a>
          <a class="button button--text" href={hero.secondaryLink.href}>
            {hero.secondaryLink.label}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <p class="hero-fieldnote">
          <span>Formicidae</span>
          <span>Phylogenomics</span>
          <span>Natural history</span>
        </p>
      </div>

      {
        hero.image.show && (
          <figure class="hero-figure">
            <img
              src={hero.image.src}
              alt={hero.image.alt}
              style={`object-position: ${hero.image.objectPosition}`}
            />
            <figcaption>{hero.image.caption}</figcaption>
          </figure>
        )
      }
    </section>

    {
      openingQuestion.show && (
        <section class="central-question" id="central-question">
          <p class="section-label">{openingQuestion.label}</p>
          <div class="question-copy">
            <h2>{openingQuestion.title}</h2>
            <p>{openingQuestion.body}</p>
          </div>
        </section>
      )
    }

    {
      researchThemes.show && (
        <section class="research-themes" id="research-themes">
          <header class="research-intro">
            <p class="section-label">{researchThemes.label}</p>
            <div>
              <h2>{researchThemes.title}</h2>
              <p>{researchThemes.introduction}</p>
            </div>
          </header>

          <div class="theme-list">
            {researchThemes.items
              .filter((theme) => theme.show)
              .map((theme) => (
                <article class:list={["theme", { "theme--without-image": !theme.image.show }]} id={theme.slug}>
                  {theme.image.show && (
                    <figure class="theme-figure">
                      <img
                        src={theme.image.src}
                        alt={theme.image.alt}
                        loading="lazy"
                        style={`object-position: ${theme.image.objectPosition}`}
                      />
                      <figcaption>{theme.image.caption}</figcaption>
                    </figure>
                  )}

                  <div class="theme-copy">
                    <p class="theme-number" aria-hidden="true">{theme.number}</p>
                    <p class="theme-question">{theme.question}</p>
                    <h3>{theme.title}</h3>
                    <p class="theme-summary">{theme.summary}</p>
                  </div>
                </article>
              ))}
          </div>
        </section>
      )
    }
  </main>
</SiteLayout>
