---
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import InlineMarkdown from "../components/InlineMarkdown.astro";
import { getEntry } from "astro:content";

const [siteEntry, homeEntry] = await Promise.all([
  getEntry("settings", "site"),
  getEntry("pages", "home"),
]);
if (!siteEntry) throw new Error("Missing src/content/settings/site.md");
if (!homeEntry) throw new Error("Missing src/content/pages/home.md");
const { identity } = siteEntry.data as any;
const { hero, researchOverview, researchThemes, peopleGateway, contact, videoFeature } = homeEntry.data as any;
const heroHasMedia = hero.image?.show;
---

<SiteLayout
  title={`${identity.name} | Ant evolution, biodiversity, and symbiosis`}
  description="The Probst Lab at UC Davis studies ant evolution, ant–plant symbioses, phylogenomics, and biodiversity."
>
  <SiteHeader variant="home" />

  <main id="main-content" tabindex="-1">
    <section class:list={["hero", { "hero--without-image": !heroHasMedia }]}>
      <div class="hero-copy">
        <p class="eyebrow hero-welcome">{hero.eyebrow}</p>
        <h1><InlineMarkdown text={hero.title} /></h1>
        <p class="hero-summary"><InlineMarkdown text={hero.summary} /></p>

        <div class="hero-actions">
          <a class="button button--primary" href={hero.primaryLink.href}>
            {hero.primaryLink.label}
            <span aria-hidden="true">↘</span>
          </a>
        </div>
      </div>

      {hero.image?.show && (
        <figure class="hero-figure">
          <img
            src={hero.image.src}
            alt={hero.image.alt}
            aria-describedby="hero-media-caption"
            style={`object-position: ${hero.image.objectPosition}`}
          />
          <figcaption id="hero-media-caption">
            <InlineMarkdown text={hero.image.caption} />
          </figcaption>
        </figure>
      )}
    </section>

    {
      researchOverview.show && (
        <section class="research-overview" id="research-overview">
          <p class="section-label">{researchOverview.label}</p>
          <div class="research-overview__question">
            <h2><InlineMarkdown text={researchOverview.question} /></h2>
          </div>
          <div class="research-overview__context">
            <p><InlineMarkdown text={researchOverview.body} /></p>
          </div>
        </section>
      )
    }

    {
      researchThemes.show && (
        <section class="research-themes" id="research-themes">
          <div class="theme-grid">
            {researchThemes.items
              .filter((theme) => theme.show)
              .map((theme, index) => (
                <article
                  class:list={["theme-card", { "theme-card--without-image": !theme.image.show }]}
                  id={theme.slug}
                  data-theme-card
                  style={`--reveal-delay: ${index * 90}ms`}
                >
                  {theme.image.show && (
                    <figure class="theme-figure">
                      <img
                        src={theme.image.src}
                        alt={theme.image.alt}
                        loading="lazy"
                        style={`object-position: ${theme.image.objectPosition}`}
                      />
                      {theme.image.caption && (
                        <figcaption><InlineMarkdown text={theme.image.caption} smallCaps={true} /></figcaption>
                      )}
                    </figure>
                  )}

                  <div class="theme-copy">
                    <p class="theme-question"><InlineMarkdown text={theme.question} /></p>
                    <h3><InlineMarkdown text={theme.title} /></h3>
                    <p class="theme-summary"><InlineMarkdown text={theme.summary} /></p>
                    <a class="theme-link" href={theme.link.href}>
                      {theme.link.label}<span aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              ))}
          </div>
        </section>
      )
    }

    {
      contact.show && (
        <section class:list={["home-contact", { "home-contact--with-video": videoFeature?.show }]}>
          {videoFeature?.show && (
            <>
              <video
                class="home-contact-video"
                data-contact-video
                src={videoFeature.src}
                poster={videoFeature.poster}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={videoFeature.alt}
                aria-describedby="home-contact-video-caption"
              />
              <div class="home-contact-video-overlay" aria-hidden="true"></div>
            </>
          )}

          <p class="section-label">{contact.label}</p>
          <div class="home-contact__content">
            <h2><InlineMarkdown text={contact.title} /></h2>
            <p><InlineMarkdown text={contact.body} /></p>
            <div class="home-contact__actions">
              <a class="button button--primary" href={contact.link.href}>
                {contact.link.label}<span aria-hidden="true">→</span>
              </a>
              {peopleGateway.show && (
                <a class="button button--outline" href={peopleGateway.link.href}>
                  {peopleGateway.link.label}<span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>

          {videoFeature?.show && (
            <>
              <p class="home-contact-video-caption" id="home-contact-video-caption">
                <InlineMarkdown text={videoFeature.caption} />
              </p>
              <button class="video-control" type="button" data-video-control aria-label="Play ant video">
                <span aria-hidden="true" data-video-control-icon>▶</span>
                <span data-video-control-label>Play video</span>
              </button>
            </>
          )}
        </section>
      )
    }
  </main>

  <script>
    const video = document.querySelector("[data-contact-video]");
    const control = document.querySelector("[data-video-control]");
    const controlLabel = document.querySelector("[data-video-control-label]");
    const controlIcon = document.querySelector("[data-video-control-icon]");

    if (
      video instanceof HTMLVideoElement &&
      control instanceof HTMLButtonElement &&
      controlLabel instanceof HTMLElement &&
      controlIcon instanceof HTMLElement
    ) {
      const updateControl = () => {
        const isPaused = video.paused;
        controlLabel.textContent = isPaused ? "Play video" : "Pause video";
        controlIcon.textContent = isPaused ? "▶" : "Ⅱ";
        control.setAttribute("aria-label", isPaused ? "Play ant video" : "Pause ant video");
      };

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              video.play().catch(updateControl);
            } else {
              video.pause();
            }
          },
          { threshold: 0.4 },
        );
        observer.observe(video);
      }

      control.addEventListener("click", () => {
        if (video.paused) {
          video.play().catch(updateControl);
        } else {
          video.pause();
        }
      });

      video.addEventListener("play", updateControl);
      video.addEventListener("pause", updateControl);
      updateControl();
    }

    const themeCards = document.querySelectorAll<HTMLElement>("[data-theme-card]");

    if (themeCards.length > 0) {
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reducedMotion || !("IntersectionObserver" in window)) {
        themeCards.forEach((card) => card.classList.add("is-visible"));
      } else {
        document.documentElement.classList.add("theme-reveal-ready");

        const cardObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                cardObserver.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px 5% 0px", threshold: 0.01 },
        );

        themeCards.forEach((card) => cardObserver.observe(card));
      }
    }
  </script>
</SiteLayout>
