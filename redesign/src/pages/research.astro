---
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import InlineMarkdown from "../components/InlineMarkdown.astro";
import { getCollection, getEntry } from "astro:content";

const [researchEntry, programEntries] = await Promise.all([
  getEntry("pages", "research"),
  getCollection("research"),
]);
if (!researchEntry) throw new Error("Missing src/content/pages/research.md");
const researchContent = researchEntry.data as any;
const { masthead, centralQuestion, strategies, programs, methods, collaborations } = researchContent;
programs.items = programEntries
  .map((entry) => entry.data as any)
  .sort((a, b) => a.order - b.order);
---

<SiteLayout
  title="Research | Probst Lab"
  description="Research in the Probst Lab uses ants to study evolution, symbiosis, systematics, phylogenomics, functional diversity, and environmental change."
>
  <SiteHeader variant="internal" />

  <main id="main-content" class="research-page" tabindex="-1">
    <section class="page-masthead research-masthead">
      <p class="section-label">{masthead.label}</p>
      <div>
        <h1><InlineMarkdown text={masthead.title} /></h1>
        <p><InlineMarkdown text={masthead.introduction} /></p>
      </div>
    </section>

    {
      masthead.image.show && (
        <figure class="research-hero-figure">
          <img
            src={masthead.image.src}
            alt={masthead.image.alt}
            style={`object-position: ${masthead.image.objectPosition}`}
          />
          <figcaption><InlineMarkdown text={masthead.image.caption} smallCaps={true} /></figcaption>
        </figure>
      )
    }

    <section class="research-question">
      <p class="section-label">{centralQuestion.label}</p>
      <div>
        <h2><InlineMarkdown text={centralQuestion.title} /></h2>
        <div class="research-question-copy">
          {centralQuestion.paragraphs.map((paragraph) => <p><InlineMarkdown text={paragraph} /></p>)}
        </div>
      </div>
    </section>

    <section class="strategy-section" aria-labelledby="strategy-title">
      <h2 id="strategy-title"><InlineMarkdown text={strategies.label} smallCaps={true} /></h2>
      <div class="strategy-grid">
        {
          strategies.items.map((strategy) => (
            <article>
              <p>{strategy.number}</p>
              <h3><InlineMarkdown text={strategy.title} /></h3>
              <span><InlineMarkdown text={strategy.description} /></span>
            </article>
          ))
        }
      </div>
    </section>

    <section class="program-section" aria-labelledby="program-title">
      <header class="program-intro">
        <p class="section-label">{programs.label}</p>
        <h2 id="program-title"><InlineMarkdown text={programs.title} /></h2>
      </header>

      <div class="program-list">
        {
          programs.items.map((program) => (
            <article class:list={["research-program", { "research-program--without-image": !program.image.show }]} id={program.slug}>
              {program.image.show && (
                <figure class="program-figure">
                  <img
                    src={program.image.src}
                    alt={program.image.alt}
                    loading="lazy"
                    style={`object-position: ${program.image.objectPosition}`}
                  />
                  <figcaption><InlineMarkdown text={program.image.caption} smallCaps={true} /></figcaption>
                </figure>
              )}

              <div class="program-copy">
                <p class="program-number">{program.number}</p>
                <p class="program-question"><InlineMarkdown text={program.question} /></p>
                <h3><InlineMarkdown text={program.title} /></h3>
                <div class="program-description">
                  {program.paragraphs.map((paragraph) => <p><InlineMarkdown text={paragraph} /></p>)}
                </div>

                <ul class="approach-list" aria-label={`${program.title} approaches`}>
                  {program.approaches.map((approach) => <li>{approach}</li>)}
                </ul>

                {program.links.length > 0 && (
                  <nav class="research-links" aria-label={`${program.title} related work`}>
                    {program.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        <InlineMarkdown text={link.label} /><span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </nav>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="methods-section" aria-labelledby="methods-title">
      <header>
        <p class="section-label">{methods.label}</p>
        <div>
          <h2 id="methods-title"><InlineMarkdown text={methods.title} /></h2>
          <p><InlineMarkdown text={methods.introduction} /></p>
        </div>
      </header>

      <div class="method-grid">
        {
          methods.items.map((method, index) => (
            <article>
              <p>{String(index + 1).padStart(2, "0")}</p>
              <h3><InlineMarkdown text={method.title} /></h3>
              <span><InlineMarkdown text={method.description} /></span>
            </article>
          ))
        }
      </div>
    </section>

    <section class="collaboration-section" aria-labelledby="collaboration-title">
      <header>
        <p class="section-label">{collaborations.label}</p>
        <div>
          <h2 id="collaboration-title"><InlineMarkdown text={collaborations.title} /></h2>
          <p><InlineMarkdown text={collaborations.introduction} /></p>
        </div>
      </header>

      <div class="collaboration-grid">
        {
          collaborations.items.map((item) => (
            <article>
              <h3><InlineMarkdown text={item.title} /></h3>
              <p><InlineMarkdown text={item.description} /></p>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</SiteLayout>
