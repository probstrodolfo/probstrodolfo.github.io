---
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import InlineMarkdown from "../components/InlineMarkdown.astro";
import { getEntry } from "astro:content";

const teachingEntry = await getEntry("pages", "teaching-outreach");
if (!teachingEntry) throw new Error("Missing src/content/pages/teaching-outreach.md");
const teachingOutreachContent = teachingEntry.data as any;
const { masthead, approach, currentTeaching, selectedTeaching, outreach, communication, invitation } = teachingOutreachContent;
---

<SiteLayout
  title="Teaching & Outreach | Probst Lab"
  description="Teaching, mentorship, public science, and community engagement from the Probst Lab at UC Davis."
>
  <SiteHeader variant="internal" />

  <main id="main-content" class="teaching-page" tabindex="-1">
    <section class="page-masthead teaching-masthead">
      <p class="section-label">{masthead.label}</p>
      <div>
        <h1><InlineMarkdown text={masthead.title} /></h1>
        <p><InlineMarkdown text={masthead.introduction} /></p>
      </div>
    </section>

    {masthead.image.show && (
      <figure class="teaching-hero-figure">
        <img
          src={masthead.image.src}
          alt={masthead.image.alt}
          style={`object-position: ${masthead.image.objectPosition}`}
        />
        <figcaption><InlineMarkdown text={masthead.image.caption} /></figcaption>
      </figure>
    )}

    <section class="teaching-approach" aria-labelledby="teaching-approach-title">
      <header>
        <p class="section-label">{approach.label}</p>
        <div>
          <h2 id="teaching-approach-title"><InlineMarkdown text={approach.title} /></h2>
          <div class="teaching-approach-copy">
            {approach.paragraphs.map((paragraph) => <p><InlineMarkdown text={paragraph} /></p>)}
          </div>
        </div>
      </header>

      <div class="learning-cycle">
        {approach.cycle.map((stage) => (
          <article>
            <p>{stage.number}</p>
            <h3><InlineMarkdown text={stage.title} /></h3>
            <span><InlineMarkdown text={stage.description} /></span>
          </article>
        ))}
      </div>
    </section>

    <section class="current-teaching" aria-labelledby="current-teaching-title">
      <header>
        <p class="section-label">{currentTeaching.label}</p>
        <div>
          <h2 id="current-teaching-title"><InlineMarkdown text={currentTeaching.title} /></h2>
          <p><InlineMarkdown text={currentTeaching.introduction} /></p>
        </div>
      </header>

      <div class="course-grid">
        {currentTeaching.courses.filter((course) => course.show).map((course) => (
          <article class="course-card">
            <div class="course-heading">
              <p>{course.code}</p>
              <span>{course.term}</span>
            </div>
            <h3><InlineMarkdown text={course.title} /></h3>
            <p class="course-summary"><InlineMarkdown text={course.summary} /></p>
            <ul aria-label={`${course.title} topics`}>
              {course.topics.map((topic) => <li>{topic}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    {selectedTeaching.show && (
      <section class="teaching-history" aria-labelledby="teaching-history-title">
        <header>
          <p class="section-label">{selectedTeaching.label}</p>
          <div>
            <h2 id="teaching-history-title"><InlineMarkdown text={selectedTeaching.title} /></h2>
            <p><InlineMarkdown text={selectedTeaching.introduction} /></p>
          </div>
        </header>

        <div class="teaching-history-list">
          {selectedTeaching.items.filter((item) => item.show).map((item) => (
            <article>
              <p class="teaching-year">{item.year}</p>
              <div>
                <h3><InlineMarkdown text={item.title} /></h3>
                <p><InlineMarkdown text={item.role} /> · <InlineMarkdown text={item.institution} /></p>
              </div>
              <p class="teaching-note"><InlineMarkdown text={item.note} /></p>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class:list={["outreach-section", { "outreach-section--without-image": !outreach.image.show }]} aria-labelledby="outreach-title">
      {outreach.image.show && (
        <figure class="outreach-figure">
          <img
            src={outreach.image.src}
            alt={outreach.image.alt}
            loading="lazy"
            style={`object-position: ${outreach.image.objectPosition}`}
          />
          <figcaption><InlineMarkdown text={outreach.image.caption} /></figcaption>
        </figure>
      )}

      <div class="outreach-copy">
        <p class="section-label">{outreach.label}</p>
        <h2 id="outreach-title"><InlineMarkdown text={outreach.title} /></h2>
        <p class="outreach-introduction"><InlineMarkdown text={outreach.introduction} /></p>
        <div class="outreach-list">
          {outreach.items.filter((item) => item.show).map((item, index) => (
            <article>
              <p>{String(index + 1).padStart(2, "0")}</p>
              <div>
                <h3><InlineMarkdown text={item.title} /></h3>
                <span><InlineMarkdown text={item.description} /></span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class:list={["science-communication", { "science-communication--without-image": !communication.image.show }]} aria-labelledby="communication-title">
      <div class="communication-copy">
        <p class="section-label">{communication.label}</p>
        <h2 id="communication-title"><InlineMarkdown text={communication.title} /></h2>
        <p><InlineMarkdown text={communication.body} /></p>
      </div>

      {communication.image.show && (
        <figure class="communication-figure">
          <img
            src={communication.image.src}
            alt={communication.image.alt}
            loading="lazy"
            style={`object-position: ${communication.image.objectPosition}`}
          />
          <figcaption><InlineMarkdown text={communication.image.caption} /></figcaption>
        </figure>
      )}
    </section>

    {invitation.show && (
      <section class="teaching-invitation">
        <p class="section-label">{invitation.label}</p>
        <div>
          <h2><InlineMarkdown text={invitation.title} /></h2>
          <p><InlineMarkdown text={invitation.body} /></p>
          <a class="button button--primary" href={`mailto:${invitation.email}`}>
            {invitation.buttonLabel}<span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}
  </main>
</SiteLayout>
