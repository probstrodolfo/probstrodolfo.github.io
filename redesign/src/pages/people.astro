---
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import InlineMarkdown from "../components/InlineMarkdown.astro";
import { getCollection, getEntry } from "astro:content";

const [peopleEntry, memberEntries] = await Promise.all([
  getEntry("pages", "people"),
  getCollection("people"),
]);
if (!peopleEntry) throw new Error("Missing src/content/pages/people.md");
const pageContent = peopleEntry.data as any;
const members = memberEntries.map((entry) => entry.data as any);
const principalInvestigator = members.find((member) => member.group === "principal-investigator");
if (!principalInvestigator) throw new Error("Missing principal-investigator profile in src/content/people/");
const graduateMembers = members
  .filter((member) => member.group === "graduate-student")
  .sort((a, b) => a.order - b.order);
const { masthead, labPhoto, graduateStudents, growingLab } = pageContent;
graduateStudents.members = graduateMembers;
---

<SiteLayout
  title="People | Probst Lab"
  description="Meet the researchers of the Probst Lab at UC Davis."
>
  <SiteHeader variant="internal" />

  <main id="main-content" class="people-page" tabindex="-1">
    <section class="people-masthead">
      <p class="section-label">{masthead.label}</p>
      <h1><InlineMarkdown text={masthead.title} /></h1>
      <p><InlineMarkdown text={masthead.introduction} /></p>
    </section>

    {
      labPhoto?.show && (
        <section class="lab-gathering" aria-label="Probst Lab gathering">
          <figure>
            <img
              src={labPhoto.src}
              alt={labPhoto.alt}
              style={`object-position: ${labPhoto.objectPosition}`}
            />
            <figcaption><InlineMarkdown text={labPhoto.caption} /></figcaption>
          </figure>
        </section>
      )
    }

    <section class="pi-profile" aria-labelledby="pi-name">
      {
        principalInvestigator.image.show && (
          <figure class="pi-portrait">
            <img
              src={principalInvestigator.image.src}
              alt={principalInvestigator.image.alt}
              style={`object-position: ${principalInvestigator.image.objectPosition}`}
            />
          </figure>
        )
      }

      <div class="pi-copy">
        <p class="profile-label">{principalInvestigator.label}</p>
        <h2 id="pi-name">{principalInvestigator.name}</h2>
        <p class="pi-role">
          <strong>{principalInvestigator.role}</strong>
          <span>{principalInvestigator.department}</span>
          <span>{principalInvestigator.institution}</span>
        </p>

        <div class="pi-biography">
          {principalInvestigator.biography.map((paragraph) => <p><InlineMarkdown text={paragraph} /></p>)}
        </div>

        <ul class="interest-list" aria-label="Research interests">
          {principalInvestigator.interests.map((interest) => <li>{interest}</li>)}
        </ul>

        <nav class="profile-links" aria-label={`${principalInvestigator.name} profiles`}>
          {
            principalInvestigator.links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label}<span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    <section class="student-section" aria-labelledby="graduate-students-title">
      <header class="student-intro">
        <p class="section-label">{graduateStudents.label}</p>
        <div>
          <h2 id="graduate-students-title"><InlineMarkdown text={graduateStudents.title} /></h2>
          <p><InlineMarkdown text={graduateStudents.introduction} /></p>
        </div>
      </header>

      <div class="member-grid">
        {
          graduateStudents.members.map((member) => (
            <article class="member-card">
              <figure class="member-visual">
                {member.image.show ? (
                  <img
                    src={member.image.src}
                    alt={member.image.alt}
                    loading="lazy"
                    style={`object-position: ${member.image.objectPosition}`}
                  />
                ) : (
                  <div class="member-placeholder" aria-label={`Photo placeholder for ${member.name}`}>
                    <span aria-hidden="true">{member.initials}</span>
                    <small>Portrait coming soon</small>
                  </div>
                )}
              </figure>

              <div class="member-copy">
                <p class="member-role">{member.role}</p>
                <h3>{member.name}</h3>
                <p class="member-biography"><InlineMarkdown text={member.biography} /></p>

                <ul class="interest-list member-interests" aria-label={`${member.name} research interests`}>
                  {member.interests.map((interest) => <li>{interest}</li>)}
                </ul>

                {member.links.length > 0 && (
                  <nav class="profile-links member-links" aria-label={`${member.name} profiles`}>
                    {member.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label}<span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </nav>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="growing-lab">
      <p class="section-label">{growingLab.label}</p>
      <div>
        <h2><InlineMarkdown text={growingLab.title} /></h2>
        {growingLab.body && <p><InlineMarkdown text={growingLab.body} /></p>}
        <a class="button button--primary" href={growingLab.link.href}>
          {growingLab.link.label}<span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
