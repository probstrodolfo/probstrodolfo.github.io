---
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import InlineMarkdown from "../components/InlineMarkdown.astro";
import { getCollection, getEntry } from "astro:content";

const [newsEntry, itemEntries] = await Promise.all([
  getEntry("pages", "news"),
  getCollection("news"),
]);
if (!newsEntry) throw new Error("Missing src/content/pages/news.md");
const newsContent = newsEntry.data as any;
const newsItems = itemEntries
  .map((entry) => entry.data as any)
  .sort((a, b) => b.order - a.order);
const { masthead } = newsContent;
const visibleItems = newsItems.filter((item) => item.show);
---

<SiteLayout
  title="News | Probst Lab"
  description="Research, student, fieldwork, and outreach news from the Probst Lab at UC Davis."
>
  <SiteHeader variant="internal" />

  <main id="main-content" class="news-page" tabindex="-1">
    <section class="news-masthead">
      <p class="section-label">{masthead.label}</p>
      <h1><InlineMarkdown text={masthead.title} /></h1>
      <p><InlineMarkdown text={masthead.introduction} /></p>
    </section>

    {visibleItems.length > 0 && (
      <section class="news-list" aria-label="Probst Lab news">
        {visibleItems.map((item) => (
          <article class="news-list-item">
            <p class="news-list-date">{item.date}</p>
            <div>
              <h2><InlineMarkdown text={item.title} /></h2>
              <p><InlineMarkdown text={item.summary} /></p>
            </div>
          </article>
        ))}
      </section>
    )}
  </main>
</SiteLayout>
