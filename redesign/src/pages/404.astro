---
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import InlineMarkdown from "../components/InlineMarkdown.astro";
import { getEntry } from "astro:content";

const notFoundEntry = await getEntry("pages", "not-found");
if (!notFoundEntry) throw new Error("Missing src/content/pages/not-found.md");
const { code, label, title, body, primaryLink, secondaryLink, image } = notFoundEntry.data as any;
---

<SiteLayout
  title="Page not found | Probst Lab"
  description="The requested page could not be found on the Probst Lab website."
  noindex={true}
>
  <SiteHeader variant="internal" />

  <main id="main-content" class="not-found-page" tabindex="-1">
    <section class="not-found-copy">
      <p class="not-found-code" aria-hidden="true">{code}</p>
      <p class="section-label">{label}</p>
      <h1><InlineMarkdown text={title} /></h1>
      <p class="not-found-summary"><InlineMarkdown text={body} /></p>

      <nav class="hero-actions" aria-label="Page not found options">
        <a class="button button--primary" href={primaryLink.href}>
          {primaryLink.label}<span aria-hidden="true">→</span>
        </a>
        <a class="button button--text" href={secondaryLink.href}>
          {secondaryLink.label}<span aria-hidden="true">↗</span>
        </a>
      </nav>
    </section>

    <figure class="not-found-figure">
      <img
        src={image.src}
        alt={image.alt}
        style={`object-position: ${image.objectPosition}`}
      />
      <figcaption><InlineMarkdown text={image.caption} /></figcaption>
    </figure>
  </main>
</SiteLayout>
