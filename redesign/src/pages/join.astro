---
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import InlineMarkdown from "../components/InlineMarkdown.astro";
import { getEntry } from "astro:content";

const joinEntry = await getEntry("pages", "join");
if (!joinEntry) throw new Error("Missing src/content/pages/join.md");
const joinContent = joinEntry.data as any;
const { masthead, availability, culture, pathways, firstMessage, contact } = joinContent;
---

<SiteLayout
  title="Join the Lab | Probst Lab"
  description="Learn about graduate, undergraduate, postdoctoral, and collaborative opportunities with the Probst Lab at UC Davis."
>
  <SiteHeader variant="internal" />

  <main id="main-content" class="join-page" tabindex="-1">
    <section class="page-masthead join-masthead">
      <p class="section-label">{masthead.label}</p>
      <div>
        <h1><InlineMarkdown text={masthead.title} /></h1>
        <p><InlineMarkdown text={masthead.introduction} /></p>
      </div>
    </section>

    {
      availability.show && (
        <aside class="availability-note" aria-labelledby="availability-title">
          <p class="availability-label"><span aria-hidden="true" />{availability.label}</p>
          <div>
            <h2 id="availability-title"><InlineMarkdown text={availability.title} /></h2>
            <p><InlineMarkdown text={availability.body} /></p>
          </div>
        </aside>
      )
    }

    <section class:list={["lab-culture", { "lab-culture--without-image": !culture.image.show }]} aria-labelledby="culture-title">
      {culture.image.show && (
        <figure class="culture-figure">
          <img
            src={culture.image.src}
            alt={culture.image.alt}
            loading="lazy"
            style={`object-position: ${culture.image.objectPosition}`}
          />
          <figcaption><InlineMarkdown text={culture.image.caption} /></figcaption>
        </figure>
      )}

      <div class="culture-copy">
        <p class="section-label">{culture.label}</p>
        <h2 id="culture-title"><InlineMarkdown text={culture.title} /></h2>
        <div class="culture-paragraphs">
          {culture.paragraphs.map((paragraph) => <p><InlineMarkdown text={paragraph} /></p>)}
        </div>
        <ul class="culture-values" aria-label="Lab values">
          {culture.values.map((value) => <li><InlineMarkdown text={value} /></li>)}
        </ul>
      </div>
    </section>

    <section class="join-pathways" aria-labelledby="pathways-title">
      <header>
        <p class="section-label">{pathways.label}</p>
        <div>
          <h2 id="pathways-title"><InlineMarkdown text={pathways.title} /></h2>
          <p><InlineMarkdown text={pathways.introduction} /></p>
        </div>
      </header>

      <div class="pathway-list">
        {pathways.items.map((pathway) => (
          <article class="pathway-card">
            <p class="pathway-number">{pathway.number}</p>
            <div class="pathway-copy">
              <h3><InlineMarkdown text={pathway.title} /></h3>
              <p><InlineMarkdown text={pathway.body} /></p>
            </div>
            <div class="pathway-details">
              <p>What to include</p>
              <ul>
                {pathway.details.map((detail) => <li><InlineMarkdown text={detail} /></li>)}
              </ul>
              {pathway.links.length > 0 && (
                <nav aria-label={`${pathway.title} links`}>
                  {pathway.links.map((link) => (
                    <a href={link.href} target="_blank" rel="noreferrer">
                      {link.label}<span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </nav>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="first-message" aria-labelledby="first-message-title">
      <header>
        <p class="section-label">{firstMessage.label}</p>
        <div>
          <h2 id="first-message-title"><InlineMarkdown text={firstMessage.title} /></h2>
          <p><InlineMarkdown text={firstMessage.introduction} /></p>
        </div>
      </header>

      <div class="message-grid">
        {firstMessage.items.map((item, index) => (
          <article>
            <p>{String(index + 1).padStart(2, "0")}</p>
            <h3><InlineMarkdown text={item.title} /></h3>
            <span><InlineMarkdown text={item.description} /></span>
          </article>
        ))}
      </div>
    </section>

    <section class="join-contact" id="contact">
      <p class="section-label">{contact.label}</p>
      <div>
        <h2><InlineMarkdown text={contact.title} /></h2>
        <p><InlineMarkdown text={contact.body} /></p>
        <a class="button button--primary" href={`mailto:${contact.email}`}>
          {contact.buttonLabel}<span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
