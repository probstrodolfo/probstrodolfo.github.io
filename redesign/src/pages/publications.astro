---
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import InlineMarkdown from "../components/InlineMarkdown.astro";
import { getCollection, getEntry } from "astro:content";

const [publicationsEntry, publicationEntries, manuscriptEntries] = await Promise.all([
  getEntry("pages", "publications"),
  getCollection("publications"),
  getCollection("manuscripts"),
]);
if (!publicationsEntry) throw new Error("Missing src/content/pages/publications.md");
const publicationsContent = publicationsEntry.data as any;
const publications = publicationEntries
  .map((entry) => entry.data as any)
  .sort((a, b) => a.order - b.order);
const manuscripts = manuscriptEntries
  .map((entry) => entry.data as any)
  .sort((a, b) => a.order - b.order);
const { masthead, selected, completeRecord, inPreparation } = publicationsContent;
inPreparation.items = manuscripts;
const visiblePublications = publications.filter((publication) => publication.show);
const featuredPublications = selected.publicationIds
  .map((id) => visiblePublications.find((publication) => publication.id === id))
  .filter((publication) => publication !== undefined);

const formatAuthors = (authors: string) =>
  authors.replaceAll("Probst, R. S.", "<strong>Probst, R. S.</strong>");
---

<SiteLayout
  title="Publications | Probst Lab"
  description="Publications from the Probst Lab on ant evolution, systematics, symbiosis, biodiversity, morphology, and phylogenomics."
>
  <SiteHeader variant="internal" />

  <main id="main-content" class="publications-page" tabindex="-1">
    <section class="publications-masthead">
      <p class="section-label">{masthead.label}</p>
      <h1><InlineMarkdown text={masthead.title} /></h1>
      <p><InlineMarkdown text={masthead.introduction} /></p>
    </section>

    {
      selected.show && (
        <section class="selected-publications" aria-labelledby="selected-publications-title">
          <header>
            <p class="section-label">{selected.label}</p>
            <div>
              <h2 id="selected-publications-title"><InlineMarkdown text={selected.title} /></h2>
              <p><InlineMarkdown text={selected.introduction} /></p>
            </div>
          </header>

          <div class="selected-publication-grid">
            {featuredPublications.map((publication, index) => (
              <article class="selected-publication-card">
                <div class="selected-publication-meta">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span>{publication.year}</span>
                </div>
                <p class="publication-type">{publication.type}</p>
                <h3><InlineMarkdown text={publication.title} /></h3>
                <p class="selected-publication-venue">
                  {publication.venue}
                  {publication.details && <span> · {publication.details}</span>}
                </p>
                {publication.href && (
                  <a href={publication.href} target="_blank" rel="noreferrer" aria-label={`Read ${publication.title.replaceAll("*", "")}`}>
                    Read publication<span aria-hidden="true">↗</span>
                  </a>
                )}
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="publication-record" aria-labelledby="publication-record-title">
      <header>
        <p class="section-label">{completeRecord.label}</p>
        <div>
          <h2 id="publication-record-title"><InlineMarkdown text={completeRecord.title} /></h2>
          {completeRecord.introduction && <p><InlineMarkdown text={completeRecord.introduction} /></p>}
        </div>
      </header>

      <div class="publication-list">
        {
          visiblePublications.map((publication) => (
            <article class="publication-entry" id={publication.id}>
              <div class="publication-year">
                <span>{publication.year}</span>
                {publication.status && <small>{publication.status}</small>}
              </div>

              <div class="publication-citation">
                <h3><InlineMarkdown text={publication.title} /></h3>
                <p class="publication-authors" set:html={formatAuthors(publication.authors)} />
                <p class="publication-venue">
                  <em>{publication.venue}</em>
                  {publication.details && <span>, {publication.details}</span>}
                </p>
                {publication.note && <p class="publication-note"><InlineMarkdown text={publication.note} /></p>}
              </div>

              <nav class="publication-action" aria-label={`Links for ${publication.title.replaceAll("*", "")}`}>
                {publication.href && (
                  <a href={publication.href} target="_blank" rel="noreferrer">
                    Article<span aria-hidden="true">↗</span>
                  </a>
                )}
                {publication.links?.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer">
                    {link.label}<span aria-hidden="true">↗</span>
                  </a>
                ))}
                {!publication.href && !publication.links?.length && <span>Link forthcoming</span>}
              </nav>
            </article>
          ))
        }
      </div>
    </section>

    {
      inPreparation.show && (
        <section class="manuscript-section" aria-labelledby="manuscript-title">
          <header>
            <p class="section-label">{inPreparation.label}</p>
            <div>
              <h2 id="manuscript-title"><InlineMarkdown text={inPreparation.title} /></h2>
              <p><InlineMarkdown text={inPreparation.introduction} /></p>
            </div>
          </header>

          <div class="manuscript-grid">
            {inPreparation.items.filter((item) => item.show).map((item, index) => (
              <article>
                <p class="manuscript-number">{String(index + 1).padStart(2, "0")}</p>
                <h3><InlineMarkdown text={item.title} /></h3>
                <p class="publication-authors" set:html={formatAuthors(item.authors)} />
                <p class="manuscript-target">Planned for <em>{item.target}</em></p>
                {"note" in item && item.note && <p class="publication-note"><InlineMarkdown text={item.note} /></p>}
              </article>
            ))}
          </div>
        </section>
      )
    }
  </main>
</SiteLayout>
